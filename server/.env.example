PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/skillpath?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Where password-reset emails point to (links go to ${APP_URL}/reset-password?token=...)
# Falls back to CLIENT_ORIGIN if unset
APP_URL=http://localhost:5173

OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
PINECONE_API_KEY=pcsk-...

# Google OAuth — get from https://console.cloud.google.com → Credentials
GOOGLE_CLIENT_ID=xxx-yyy.apps.googleusercontent.com

# Resend (transactional email) — https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sandbox sender is fine for demos; for production, verify a domain in Resend.
EMAIL_FROM=SkillPath <onboarding@resend.dev>
